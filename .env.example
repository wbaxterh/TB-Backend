# Database
ATLAS_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# Authentication
JWT_SECRET=your-jwt-secret

# AWS S3
AWS_KEY=your-aws-key
AWS_SECRET=your-aws-secret
AWS_REGION=us-east-1

# Google
GOOGLE_CLIENT_ID=your-google-web-client-id
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_DRIVE_FOLDER_ID=your-folder-id
GOOGLE_DRIVE_CREDENTIALS_PATH=config/google-drive-credentials.json

# Apple
APPLE_CLIENT_ID=com.thetrickbook.trickbook
APPLE_WEB_SERVICE_ID=com.thetrickbook.web

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PRICE_ID=price_...
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_...

# Bunny.net (Video Streaming)
BUNNY_API_KEY=your-bunny-api-key
BUNNY_LIBRARY_ID=your-library-id
BUNNY_LIBRARY_API_KEY=your-library-api-key
BUNNY_CDN_HOSTNAME=your-cdn-hostname
BUNNY_STREAM_TOKEN_KEY=your-stream-token-key

# Email (Nodemailer)
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password

# Frontend
FRONTEND_URL=http://localhost:3000

# Kith Voice Service (Kaori TTS sidecar)
KITH_VOICE_URL=http://localhost:3040

# Server
PORT=9000
